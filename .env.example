# ============================================================
#  Credenciales de CJ Dropshipping API V2.0
#  Copiá este archivo a ".env" y completá tus datos reales.
# ============================================================

# API Key de CJ. La generás en: cjdropshipping.com -> My CJ -> Authorization -> API.
# Tiene el formato:  CJUserNum@api@xxxxxxxxxxxxxxxxxxxxxxxx
CJ_API_KEY=

# (Opcional) Fallback para cuentas antiguas que autentican con email + password.
# En esas cuentas el "password" de la API suele ser la propia API key.
# Dejalo vacío si usás CJ_API_KEY.
CJ_EMAIL=
CJ_PASSWORD=

# Peticiones por segundo permitidas según tu nivel de cuenta CJ:
#   Free / Sales 0-1  -> 1
#   Plus / Sales 2    -> 2
#   Prime / Sales 3   -> 4
#   Advanced / Sales 4-5 -> 6
CJ_QPS=1


# ============================================================
#  MercadoLibre (research: demanda real, precios, competencia)
# ============================================================
# 1) Creá una app en https://developers.mercadolibre.com.ar -> Mis aplicaciones
# 2) Configurá un Redirect URI (ej. https://localhost/callback)
# 3) Copiá App ID y Secret Key acá abajo.
ML_CLIENT_ID=
ML_CLIENT_SECRET=

# Debe coincidir EXACTAMENTE con el Redirect URI registrado en tu app.
ML_REDIRECT_URI=https://localhost/callback

# Tu país de MercadoLibre (define el mercado que vas a analizar):
#   MLU=Uruguay  MLA=Argentina  MLM=México  MLC=Chile  MCO=Colombia
#   MLB=Brasil  MPE=Perú  MEC=Ecuador  ...  (NO existe España)
ML_SITE_ID=MLU


# ============================================================
#  Scoring
# ============================================================
# Tasa USD -> moneda local para el margen (costo CJ en USD, precios ML en local).
# Uruguay: ~40 UYU por USD. Ajustá al valor actual.
USD_TO_LOCAL_RATE=40


# ============================================================
#  Shopify (publicar productos como borrador)
# ============================================================
# 1) En tu tienda: Settings -> Apps and sales channels -> Develop apps -> crear app
# 2) Configure Admin API scopes: write_products, read_products
#    (y write_publications/read_publications si vas a publicar a un canal)
# 3) Install app -> Reveal token (empieza con shpat_), se muestra UNA sola vez
SHOPIFY_SHOP_DOMAIN=mi-tienda.myshopify.com
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-04
